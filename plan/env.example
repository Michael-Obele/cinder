# Server Configuration
PORT=8080
GIN_MODE=debug # release in production
LOG_LEVEL=info

# Authentication
# Simple API Key for protecting your endpoints
API_KEY=sk_my_secret_key_12345

# Redis Configuration (Required for Async/Crawl)
#
# Option A — Standard Redis URL (supports redis:// and rediss:// TLS)
REDIS_URL=redis://localhost:6379
#   Examples:
#   Local:    redis://localhost:6379
#   Upstash:  rediss://default:password@your-instance.upstash.io:6379
#
# Option B — Upstash REST credentials (auto-derives the TLS Redis URL)
#   These are the standard env vars the Upstash Console provides.
#   Falls back to this only if REDIS_URL is not set.
# UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_token_here

# Scraper Configuration
# Max concurrent scrapes to prevent getting banned
MAX_CONCURRENCY=5
# User Agent is handled automatically by the app (rotating), 
# but you can set a fixed one here to override if needed.
# USER_AGENT=Mozilla/5.0 (compatible; CinderBot/1.0; +http://cinder.svelte-apps.me)
